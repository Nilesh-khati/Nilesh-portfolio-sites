# Development placeholders for the Base44 sandbox.
# Listed FIRST in docker-compose.base44.yml env_file, so values delivered in
# /run/base44/app.env (dashboard secrets) always override these.

# Local MongoDB service from docker-compose.base44.yml.
# Replace with your own cluster URI (e.g. MongoDB Atlas) via the Secrets page.
MONGODB_URI=mongodb://mongo:27017/
DB_NAME=portfolio

# Admin dashboard login (see QUICK_START.md). Change these to your own values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
